{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/publicidad", "destination": "/" },
    { "source": "/automation-local.js", "destination": "/public/automation-local.js" },
    { "source": "/app.js", "destination": "/public/app.js" },
    { "source": "/styles.css", "destination": "/public/styles.css" },
    { "source": "/favicon.svg", "destination": "/public/favicon.svg" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "microphone=(self), camera=(self)" }
      ]
    }
  ]
}
