    },
    {
      "parameters": {
        "assignments": {"assignments": [{"id": "status-email", "name": "result", "value": "DEMO: correo preparado correctamente", "type": "string"}]},
        "includeOtherFields": true,
        "options": {}
      },
      "id": "demo-email",
      "name": "DEMO - Enviar email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [40, 20]
    },
    {
      "parameters": {
        "assignments": {"assignments": [{"id": "status-whatsapp", "name": "result", "value": "DEMO: mensaje preparado para WhatsApp", "type": "string"}]},
        "includeOtherFields": true,
